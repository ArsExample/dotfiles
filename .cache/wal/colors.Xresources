! X colors.
! Generated by 'wal'
*foreground:        #f4c5ba
*background:        #0E172E
*.foreground:       #f4c5ba
*.background:       #0E172E
emacs*foreground:   #f4c5ba
emacs*background:   #0E172E
URxvt*foreground:   #f4c5ba
XTerm*foreground:   #f4c5ba
UXTerm*foreground:  #f4c5ba
URxvt*background:   [100]#0E172E
XTerm*background:   #0E172E
UXTerm*background:  #0E172E
URxvt*cursorColor:  #f4c5ba
XTerm*cursorColor:  #f4c5ba
UXTerm*cursorColor: #f4c5ba
URxvt*borderColor:  [100]#0E172E

! Colors 0-15.
*.color0: #0E172E
*color0:  #0E172E
*.color1: #9B4F6C
*color1:  #9B4F6C
*.color2: #EA656E
*color2:  #EA656E
*.color3: #B78E75
*color3:  #B78E75
*.color4: #F98F7A
*color4:  #F98F7A
*.color5: #70608E
*color5:  #70608E
*.color6: #916B96
*color6:  #916B96
*.color7: #f4c5ba
*color7:  #f4c5ba
*.color8: #aa8982
*color8:  #aa8982
*.color9: #9B4F6C
*color9:  #9B4F6C
*.color10: #EA656E
*color10:  #EA656E
*.color11: #B78E75
*color11:  #B78E75
*.color12: #F98F7A
*color12:  #F98F7A
*.color13: #70608E
*color13:  #70608E
*.color14: #916B96
*color14:  #916B96
*.color15: #f4c5ba
*color15:  #f4c5ba

! Black color that will not be affected by bold highlighting.
*.color66: #0E172E
*color66:  #0E172E

! Xclock colors.
XClock*foreground: #f4c5ba
XClock*background: #0E172E
XClock*majorColor:  rgba:f4/c5/ba/ff
XClock*minorColor:  rgba:f4/c5/ba/ff
XClock*hourColor:   rgba:f4/c5/ba/ff
XClock*minuteColor: rgba:f4/c5/ba/ff
XClock*secondColor: rgba:f4/c5/ba/ff

! Set depth to make transparency work.
URxvt*depth: 32
