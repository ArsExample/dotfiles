{
	"hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": true,
        "format-icons": {
        "default": "󰫣 ",
        "active": "󰫢 "
		}
	},
// 󰝟        
	"wireplumber": {
		"format": "{icon}   {volume}%",
		"format-muted": "  muted",
		"format-icons": ["", ""]
	},

	"clock": {
		"format": "{:%H:%M}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"on-click": "swaync-client -t",
		"calendar": {
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ffcc66'><b><u>{}</u></b></span>"
			}
		}
	},

	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 20
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        //"format-charging": "󰋠   {capacity}",
		//"format-plugged": "󰋠    {capacity}",
		"format-alt": "{time}   {icon}",
        //"format-icons": ["󱢠 󱢠 󱢠 ", "󱢠 󱢠 󰛞 ", "󱢠 󱢠 󰛞 ", "󱢠 󱢠 󰋑 ", "󱢠 󰛞 󰋑 ", "󱢠 󰛞 󰋑 ", "󱢠 󰋑 󰋑 ", "󰛞 󰋑 󰋑 ", "󰛞 󰋑 󰋑 ", "󰋑 󰋑 󰋑 "]
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		//"format-icons": [" ", " ", " ", " ", " "]
	},

	"network": {
		//"format-wifi": "    {signalStrength}%",
		"format-wifi": "",
		"format-ethernet": "{ipaddr}/{cidr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "󰖪 ",
        "on-click": "exec ~/.config/rofi/assets/wifimenu --rofi -s",
        "tooltip-format":"Network: <big><b>{essid}</b></big>\n<b>  {bandwidthUpBytes}   {bandwidthDownBytes}</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIp: <b>{ipaddr}/{cidr}</b>",
		"interval": 1,
    },

	"bluetooth": {
		"format": "󰂯    {status}",
		"format-disabled": " off",
		"format-connected": " {num_connections}",
		"tooltip-format": "{device_alias}",
		"tooltip-format-connected": " {device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"on-click": "kitty -e bluetui"
	},

    "custom/recording": {
        "exec": "~/.config/waybar/script/recording_status.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "bash ~/.config/hypr/script/recorder.sh"
    },

    "group/custom-group": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "battery",
            "network"
        ]
    },

	"hyprland/language": {
		"format": "{}",
		"format-us": "US",
		"format-en": "🇺🇸",
		"format-ru": "🇷🇺",
		"format-de": "DE",
		"on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next" // Adjust keyboard name
	}
}

